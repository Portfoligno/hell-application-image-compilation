{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Portfoligno/hell-application-image-compilation/blob/main/release/spdx-2.3.schema.json",
  "title": "SPDX 2.3 static release SBOM profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spdxVersion",
    "dataLicense",
    "SPDXID",
    "name",
    "documentNamespace",
    "creationInfo",
    "documentDescribes",
    "packages",
    "files",
    "relationships"
  ],
  "properties": {
    "spdxVersion": {
      "const": "SPDX-2.3"
    },
    "dataLicense": {
      "const": "CC0-1.0"
    },
    "SPDXID": {
      "const": "SPDXRef-DOCUMENT"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "documentNamespace": {
      "type": "string",
      "format": "uri"
    },
    "creationInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "creators"
      ],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "documentDescribes": {
      "const": [
        "SPDXRef-Package"
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 5,
      "contains": {
        "type": "object",
        "required": [
          "SPDXID",
          "filesAnalyzed",
          "packageVerificationCode"
        ],
        "properties": {
          "SPDXID": {
            "const": "SPDXRef-Package"
          },
          "filesAnalyzed": {
            "const": true
          },
          "packageVerificationCode": {
            "type": "object",
            "required": [
              "packageVerificationCodeValue"
            ],
            "properties": {
              "packageVerificationCodeValue": {
                "type": "string"
              }
            }
          }
        }
      },
      "items": {
        "type": "object",
        "required": [
          "name",
          "SPDXID",
          "versionInfo",
          "downloadLocation",
          "filesAnalyzed",
          "licenseConcluded",
          "licenseDeclared",
          "copyrightText"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileName",
          "SPDXID",
          "checksums",
          "fileTypes",
          "licenseConcluded",
          "copyrightText"
        ],
        "properties": {
          "fileName": {
            "enum": [
              "hell",
              "README.md",
              "LICENSE"
            ]
          },
          "SPDXID": {
            "type": "string"
          },
          "checksums": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "checksumValue"
              ],
              "properties": {
                "algorithm": {
                  "enum": [
                    "SHA1",
                    "SHA256"
                  ]
                },
                "checksumValue": {
                  "type": "string"
                }
              }
            }
          },
          "fileTypes": {
            "type": "array",
            "minItems": 1
          },
          "licenseConcluded": {
            "const": "BSD-3-Clause"
          },
          "copyrightText": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spdxElementId",
          "relationshipType",
          "relatedSpdxElement"
        ],
        "properties": {
          "spdxElementId": {
            "const": "SPDXRef-Package"
          },
          "relationshipType": {
            "enum": [
              "CONTAINS",
              "DEPENDS_ON"
            ]
          },
          "relatedSpdxElement": {
            "type": "string"
          }
        }
      }
    }
  }
}
