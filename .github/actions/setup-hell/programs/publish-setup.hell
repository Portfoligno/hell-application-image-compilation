#!/usr/bin/env hell
data Opts = Opts { state :: Text, binary :: Text, binDir :: Text }

options =
  (\state binary binDir -> Main.Opts { state, binary, binDir })
  <$> Options.strOption (Option.long "state")
  <*> Options.strOption (Option.long "binary")
  <*> Options.strOption (Option.long "bin-dir")

die = \message -> Exit.die $ Text.concat ["setup-hell publication failed: ", message]

require = \condition message ->
  if condition then Applicative.pure () else Main.die message

and = \left right -> if left then right else Bool.False

string = \name fields ->
  Maybe.maybe
    (Main.die $ Text.concat ["missing string state field: ", name])
    (\value -> Json.value
      (Main.die $ Text.concat ["non-string state field: ", name])
      (\boolean -> Main.die $ Text.concat ["non-string state field: ", name])
      Applicative.pure
      (\number -> Main.die $ Text.concat ["non-string state field: ", name])
      (\array -> Main.die $ Text.concat ["non-string state field: ", name])
      (\objectFields -> Main.die $ Text.concat ["non-string state field: ", name])
      value)
    $ Map.lookup name fields

safe = \value -> Main.and (Bool.not $ Text.isInfixOf "\n" value) (Bool.not $ Text.isInfixOf "\r" value)

environment = \name environment ->
  Maybe.maybe (Main.die $ Text.concat ["missing environment variable: ", name]) Applicative.pure
    $ List.lookup name environment

main = do
  opts <- Options.execParser $ Options.info (Main.options <**> Options.helper) Options.fullDesc
  bytes <- ByteString.readFile $ Record.get @"state" opts
  value <- Maybe.maybe (Main.die "invalid validated state JSON") Applicative.pure $ Json.decode bytes
  fields <- case value of
    Json.Object objectFields -> Applicative.pure objectFields
    _ -> Main.die "validated state is not an object"
  Main.require (Eq.eq (Set.fromList $ Map.keys fields)
    (Set.fromList ["schemaVersion","binary","archiveSha256","binarySha256","buildIdentity","cacheHit"]))
    "unexpected validated state fields"
  stateBinary <- Main.string "binary" fields
  archiveSha256 <- Main.string "archiveSha256" fields
  binarySha256 <- Main.string "binarySha256" fields
  buildIdentity <- Main.string "buildIdentity" fields
  cacheHit <- Main.string "cacheHit" fields
  let binary = Record.get @"binary" opts
  let binDir = Record.get @"binDir" opts
  Main.require (Eq.eq stateBinary binary) "validated binary path mismatch"
  symbolic <- Directory.pathIsSymbolicLink binary
  Main.require (Bool.not symbolic) "validated binary became a symbolic link"
  (code, hashOutput, hashError) <- Text.readProcess $ Process.proc "/usr/bin/sha256sum" [binary]
  Main.require (Main.and (Eq.eq code Exit.ExitSuccess) (Eq.eq hashError "")) "unable to rehash validated binary"
  Main.require (Text.isPrefixOf binarySha256 hashOutput) "validated binary changed"
  Monad.mapM_ (\item -> Main.require (Main.safe item) "unsafe output value")
    [binary, binDir, cacheHit, archiveSha256, buildIdentity]
  env <- Environment.getEnvironment
  githubPath <- Main.environment "GITHUB_PATH" env
  githubOutput <- Main.environment "GITHUB_OUTPUT" env
  Text.appendFile githubPath $ Text.concat [binDir, "\n"]
  Text.appendFile githubOutput $ Text.unlines [
    Text.concat ["hell-path=", binary],
    Text.concat ["bin-dir=", binDir],
    Text.concat ["cache-hit=", cacheHit],
    Text.concat ["archive-sha256=", archiveSha256],
    Text.concat ["build-identity=", buildIdentity]
    ]
