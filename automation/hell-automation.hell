#!/usr/bin/env hell

-- Backward-compatible public dispatcher for independently compiled automation.
-- The original Text argument vector crosses every process boundary unchanged.

die = \message -> Exit.die (Text.concat ["hell automation: ", message])

require = \condition message ->
  if condition then IO.pure () else Main.die message

argument = \position values ->
  Maybe.maybe
    (Error.error "missing command argument")
    Function.id
    (Maybe.listToMaybe (List.drop position values))

envDefault = \name fallback -> do
  values <- Environment.getEnvironment
  IO.pure (Maybe.maybe fallback Function.id (List.lookup name values))

joinPath = \parent child ->
  Maybe.maybe
    (Text.concat [parent, "/", child])
    (\without -> Text.concat [without, "/", child])
    (Text.stripSuffix "/" parent)

substitutedChecksImage = "@checksImage@"
substitutedReleaseBuildImage = "@releaseBuildImage@"
substitutedReleaseControlImage = "@releaseControlImage@"

defaultChecksImage =
  if Text.isPrefixOf "@" Main.substitutedChecksImage
    then "automation/hell-automation-checks.hell"
    else Main.substitutedChecksImage

defaultReleaseBuildImage =
  if Text.isPrefixOf "@" Main.substitutedReleaseBuildImage
    then "automation/hell-automation-release-build.hell"
    else Main.substitutedReleaseBuildImage

defaultReleaseControlImage =
  if Text.isPrefixOf "@" Main.substitutedReleaseControlImage
    then "automation/hell-automation-release-control.hell"
    else Main.substitutedReleaseControlImage

fixedTag = "application-image-compilation/v1.0.0"

selfTest = do
  Main.require (Eq.eq (Main.joinPath "a/" "b") "a/b") "path join failed"
  Main.require (Eq.eq Main.fixedTag "application-image-compilation/v1.0.0") "tag policy failed"
  Text.putStrLn "hell automation self-test passed"

usage =
  Main.die
    "usage: hell-automation {policy|metadata|hpack-drift|check-sdist|generate-docs|check-docs|check-runtime BINARY ARCH|check-bundle DIRECTORY ARCH|aggregate INCOMING OUTPUT COMMIT|stage-draft DIRECTORY|verify-published DIRECTORY|nix-release|nix-check|self-test}"

main = do
  arguments <- Environment.getArgs
  let command = Main.argument 0 arguments
  if Eq.eq command "self-test"
    then Main.selfTest
    else do
      target <-
        if List.elem command
          ["policy", "metadata", "hpack-drift", "check-sdist", "generate-docs", "check-docs", "nix-check"]
          then Main.envDefault "HELL_AUTOMATION_CHECKS" Main.defaultChecksImage
          else if List.elem command ["check-runtime", "check-bundle", "nix-release"]
            then Main.envDefault "HELL_AUTOMATION_RELEASE_BUILD" Main.defaultReleaseBuildImage
            else if List.elem command ["aggregate", "stage-draft", "verify-published"]
              then Main.envDefault "HELL_AUTOMATION_RELEASE_CONTROL" Main.defaultReleaseControlImage
              else Main.usage
      code <- Process.runProcess (Process.proc target arguments)
      Exit.exitWith code
